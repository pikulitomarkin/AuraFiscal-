# RoboFiscal — Matheus Costa Serviços Médicos (Tubarão-SC)
# Canais: ClickCannabis e Bliss
APP_NAME="RoboFiscal — Matheus Costa NFS-e"
APP_VERSION="1.0.0"
DEBUG=False
SECRET_KEY="your-secret-key-here-change-in-production"

# Banco de Dados
DATABASE_URL="sqlite+aiosqlite:///./nfse.db"
DB_ECHO=False

# API Nacional NFS-e (Sefin Nacional)
NFSE_API_BASE_URL="https://sefin.nfse.gov.br"
NFSE_API_AMBIENTE="PRODUCAO"  # HOMOLOGACAO ou PRODUCAO
NFSE_API_TIMEOUT=30
NFSE_API_MAX_RETRIES=3

# Certificado Digital A1 (Matheus Costa) — configure via Base64 no Railway
CERTIFICATE_PATH="certificados/cert.pem"
CERTIFICATE_PASSWORD=""
# CERTIFICATE_CERT_PEM=
# CERTIFICATE_KEY_PEM=

# Prestador
PRESTADOR_CNPJ="53380857000140"
PRESTADOR_IM="89944"
PRESTADOR_RAZAO_SOCIAL="MATHEUS COSTA SERVICOS MEDICOS LTDA"
PRESTADOR_CODIGO_IBGE="4218707"
DPS_SERIE="70000"
ITEM_LISTA_SERVICO="04.01.01"
CODIGO_NBS="1.2301.21.00"
OP_SIMP_NAC="2"
REG_AP_TRIB_SN="2"
ALIQUOTA_ISS_PADRAO=2.0

# Processamento — valor do PDF tem prioridade; este é só fallback
MAX_BATCH_SIZE=600
MIN_BATCH_SIZE=1
CONCURRENT_REQUESTS=10
VALOR_EMISSAO_LOTE=45.00

# Logs
LOG_LEVEL="INFO"
LOG_FILE="logs/nfse_automation.log"

# Autenticação
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="$2b$12$example_hash_here"

# Streamlit
STREAMLIT_SERVER_PORT=8502
STREAMLIT_SERVER_ADDRESS="localhost"
